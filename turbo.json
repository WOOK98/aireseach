{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".cache/tsbuildinfo.json", "dist/**", "build/**"]
    },
    "//#lint": {},
    "//#lint:fix": {
      "cache": false
    },
    "//#format": {},
    "//#format:fix": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": false
    },
    "clean": {
      "cache": false
    },
    "setup": {
      "cache": false,
      "dependsOn": ["@workspace/db#db:setup"]
    },
    "test": {
      "outputs": ["coverage.json"]
    }
  },
  "globalEnv": [
    "DATABASE_URL",
    "PRODUCT_NAME",
    "URL",
    "DEFAULT_LOCALE",
    "REPORT_AGENT_URL",
    "BETTER_AUTH_SECRET",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "CONTACT_EMAIL",
    "KIMI_API_KEY",
    "OPENAI_API_KEY",
    "DEEPSEEK_API_KEY",
    "LLM_API_KEY",
    "ALEABIT_INGEST_SECRET",
    "ALEABIT_ROLLOUT_MODE",
    "X_BEARER_TOKEN",
    "X_WRITE_BEARER_TOKEN",
    "ALEABIT_LIVE_CREATORS",
    "ALEABIT_PUBLISH_MODE",
    "ALEABIT_PUBLISH_DRY_RUN",
    "ALEABIT_PUBLISH_KILL_SWITCH",
    "ALEABIT_ADMIN_USER_IDS"
  ],
  "globalPassThroughEnv": [
    "AIRESEARCH_PLUGIN_DIR",
    "NODE_ENV",
    "SKIP_ENV_VALIDATION",
    "npm_lifecycle_event"
  ]
}
